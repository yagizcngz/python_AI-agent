# OpenRouter API Key (Get yours at https://openrouter.ai/)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Default Model (Free OpenRouter model or local model)
OPENROUTER_MODEL=nvidia/nemotron-3.5-lightning:free

# Custom Base URL (Optional: for local Ollama, LM Studio, or vLLM)
# Default is https://openrouter.ai/api/v1
# For local Ollama: http://localhost:11434/v1
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Workspace Root (Optional: defaults to project root)
# AI_AGENT_WORKSPACE=.
